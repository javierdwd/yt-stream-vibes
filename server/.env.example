YOUTUBE_API_KEY=
TYPESAFE_API_KEY=

# Twitch (operator-only — no end-user login)
# 1) Create an app at https://dev.twitch.tv/console → Client ID + Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# 2) Authorize a bot account once with scope user:read:chat, then paste:
#    - TWITCH_BOT_USER_ID = numeric user id of that bot
#    - TWITCH_BOT_TOKEN = user access token for that bot
TWITCH_BOT_USER_ID=
TWITCH_BOT_TOKEN=

# Local streamer STT (YouTube only). Requires system ffmpeg + yt-dlp on PATH.
# brew install ffmpeg yt-dlp   # macOS
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# YouTube CDN returns HTTP 403 on googlevideo segments from most datacenter IPs
# (AWS/GCP/Azure). Cookies help the webpage/API bot-check but often do NOT fix
# segment 403s — you need a residential egress (proxy or run outside the DC).
# Local (has a browser):
#   YTDLP_COOKIES_FROM_BROWSER=chrome
# AWS / Docker (no browser) — export once on your Mac, then mount the file:
#   yt-dlp --cookies-from-browser chrome --cookies server/secrets/youtube-cookies.txt \
#     --skip-download "https://www.youtube.com"
#   # docker-compose mounts that file at /data/cookies/youtube.txt
#   YTDLP_COOKIES=/data/cookies/youtube.txt
# Confirm the export includes LOGIN_INFO (logged-in session). Visitor-only cookies
# are usually not enough.
# Required on AWS for STT: residential / SOCKS proxy so googlevideo sees a home IP.
#   YTDLP_PROXY=http://user:pass@brd.superproxy.io:22225
#   # or socks5://…
# Theme one-liner (streamer speech + recent chat). Soft-fails if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS origins for the Next.js app (comma-separated)
# Local: http://localhost:3000
# Prod:  https://yt-stream-vibes.javiervb.com
CORS_ORIGINS=http://localhost:3000,https://yt-stream-vibes.javiervb.com
